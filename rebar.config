{erl_opts, [debug_info]}.

{deps, [
    {datastar, {git, "https://github.com/Taure/datastar.git", {tag, "v0.1.0"}}},
    {nova, {git, "https://github.com/novaframework/nova.git", {branch, "master"}}}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_hex,
    {rebar3_audit, "~> 0.2"},
    rebar3_sbom
]}.

{erlfmt, [
    write,
    {files, ["src/*.erl", "src/*.app.src", "test/*.erl", "rebar.config"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [cowboy, cowlib, ranch, nova, datastar]}
]}.

{ex_doc, [
    {proglang, erlang},
    {main, <<"readme">>},
    {extras, [<<"README.md">>, <<"ARCHITECTURE.md">>, <<"LICENSE.md">>]},
    {source_url, <<"https://github.com/Taure/datastar_nova">>}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{shell, [{apps, [datastar_nova]}]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.
